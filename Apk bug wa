import java.util.Random;

public class BugGenerator {
    private static final Random RNG = new Random();

    public static String generate(String jenis) {
        switch (jenis) {
            case "fc":    return fc();
            case "delay": return delay();
            case "blank": return blank();
            case "rtl":   return rtl();
            case "zalgo": return zalgo();
            case "bomb":  return bomb();
            case "crash": return crash();
            case "hang":  return hang();
            default:      return crash();
        }
    }

    private static String fc() {
        String[] e = {"🇦","🇧","🇨","🇩","🇪","🇫","🇬","🇭","🇮","🇯","🇰","🇱","🇲","🇳","🇴","🇵"};
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 3000; i++) sb.append(e[i % e.length]);
        return sb.toString();
    }
    private static String delay() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 40000; i++) sb.append('\u2067');
        return sb.toString();
    }
    private static String blank() {
        StringBuilder sb = new StringBuilder();
        char[] m = new char[0x170];
        int idx = 0;
        for (int i = 0x0300; i <= 0x036F; i++) m[idx++] = (char) i;
        for (int c = 0; c < 700; c++) {
            sb.append('A');
            for (int i = 0; i < 60; i++) sb.append(m[RNG.nextInt(idx)]);
        }
        return sb.toString();
    }
    private static String rtl() {
        StringBuilder sb = new StringBuilder();
        sb.append('\u202E');
        for (int i = 0; i < 700; i++) sb.append("!dlrow olleH");
        sb.append('\u202C');
        return sb.toString();
    }
    private static String zalgo() {
        StringBuilder sb = new StringBuilder();
        char[] m = new char[0x70];
        int idx = 0;
        for (int i = 0x0300; i <= 0x036F; i++) m[idx++] = (char) i;
        for (int c = 0; c < 200; c++) {
            sb.append("💀");
            for (int i = 0; i < 80; i++) sb.append(m[RNG.nextInt(idx)]);
        }
        return sb.toString();
    }
    private static String bomb() {
        String[] p = {"💣","💥","🔥","⚡","🌀","💀","☠️","👺","🤖","👾","🎃","👻","😈","👿","🕷","🦂"};
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 5000; i++) sb.append(p[i % p.length]);
        return sb.toString();
    }
    private static String crash() {
        StringBuilder sb = new StringBuilder();
        char[] m = new char[0x70];
        int idx = 0;
        for (int i = 0x0300; i <= 0x036F; i++) m[idx++] = (char) i;
        for (int c = 0; c < 1200; c++) {
            sb.append((char) (0x0900 + RNG.nextInt(200)));
            for (int i = 0; i < 90; i++) sb.append(m[RNG.nextInt(idx)]);
        }
        return sb.toString();
    }
    private static String hang() {
        StringBuilder sb = new StringBuilder();
        sb.append('\u202E');
        for (int i = 0; i < 7000; i++) sb.append("\u2067\u202E");
        return sb.toString();
    }
