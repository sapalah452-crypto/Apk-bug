import android.accessibilityservice.AccessibilityService;
import android.content.ClipData;
import android.content.ClipboardManager;
import android.content.Context;
import android.os.Bundle;
import android.view.accessibility.AccessibilityEvent;
import android.view.accessibility.AccessibilityNodeInfo;

import java.util.List;

public class AutoSendService extends AccessibilityService {
    public static AutoSendService instance;
    private String pendingText = null;
    private boolean waiting = false;
    private long lastTrigger = 0;

    @Override
    public void onServiceConnected() {
        super.onServiceConnected();
        instance = this;
    }

    public void triggerSend(String nomor, String jenisBug) {
        String teks = BugGenerator.generate(jenisBug);
        ClipboardManager cm = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
        cm.setPrimaryClip(ClipData.newPlainText("bug", teks));
        pendingText = teks;
        waiting = true;
        lastTrigger = System.currentTimeMillis();
        android.content.Intent i = new android.content.Intent(android.content.Intent.ACTION_VIEW);
        i.setData(android.net.Uri.parse("https://wa.me/" + nomor));
        i.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
        startActivity(i);
    }

    @Override
    public void onAccessibilityEvent(AccessibilityEvent event) {
        if (event == null || !waiting) return;
        if (event.getPackageName() == null) return;
        String pkg = event.getPackageName().toString();
        if (!pkg.equals("com.whatsapp") && !pkg.equals("com.whatsapp.w4b")) return;
        if (System.currentTimeMillis() - lastTrigger > 15000) {
            waiting = false; pendingText = null; return;
        }
        AccessibilityNodeInfo root = getRootInActiveWindow();
        if (root == null) return;
        AccessibilityNodeInfo edit = findInput(root);
        if (edit == null) return;
        Bundle args = new Bundle();
        args.putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, pendingText);
        edit.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args);
        edit.postDelayed(() -> {
            AccessibilityNodeInfo r2 = getRootInActiveWindow();
            if (r2 == null) return;
            AccessibilityNodeInfo send = findSend(r2);
            if (send != null && send.isClickable()) {
                send.performAction(AccessibilityNodeInfo.ACTION_CLICK);
                waiting = false; pendingText = null;
            }
        }, 700);
    }

    private AccessibilityNodeInfo findInput(AccessibilityNodeInfo root) {
        List<AccessibilityNodeInfo> l = root.findAccessibilityNodeInfosByViewId("com.whatsapp:id/entry");
        if (l == null || l.isEmpty()) l = root.findAccessibilityNodeInfosByViewId("com.whatsapp.w4b:id/entry");
        if (l != null && !l.isEmpty()) return l.get(0);
        return findClass(root, "android.widget.EditText");
    }
    private AccessibilityNodeInfo findSend(AccessibilityNodeInfo root) {
        List<AccessibilityNodeInfo> l = root.findAccessibilityNodeInfosByViewId("com.whatsapp:id/send");
        if (l == null || l.isEmpty()) l = root.findAccessibilityNodeInfosByViewId("com.whatsapp.w4b:id/send");
        if (l != null && !l.isEmpty()) return l.get(0);
        return findDesc(root, "Send");
    }
    private AccessibilityNodeInfo findClass(AccessibilityNodeInfo n, String c) {
        if (n == null) return null;
        if (n.getClassName() != null && n.getClassName().toString().equals(c)) return n;
        for (int i = 0; i < n.getChildCount(); i++) {
            AccessibilityNodeInfo r = findClass(n.getChild(i), c);
            if (r != null) return r;
        }
        return null;
    }
    private AccessibilityNodeInfo findDesc(AccessibilityNodeInfo n, String d) {
        if (n == null) return null;
        if (n.getContentDescription() != null && n.getContentDescription().toString().equalsIgnoreCase(d)) return n;
        for (int i = 0; i < n.getChildCount(); i++) {
            AccessibilityNodeInfo r = findDesc(n.getChild(i), d);
            if (r != null) return r;
        }
        return null;
    }
    @Override public void onInterrupt() { waiting = false; pendingText = null; }
